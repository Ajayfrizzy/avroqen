# Local development only. Copy to .env and replace the password placeholder.
# Never put wallet, owner, verifier, agent, or mainnet credentials here.
PGUSER=avroqen_dev
PGDATABASE=avroqen_dev
PGPASSWORD=REPLACE_WITH_LOCAL_ONLY_PASSWORD
PGHOST=127.0.0.1
PGPORT=55432
HOST=127.0.0.1
PORT=3001

# Explicit loopback-only HTTP authentication exception for local development.
PUBLIC_ORIGIN=http://127.0.0.1:3000
AUTH_ALLOW_INSECURE_LOCALHOST=true
NEAR_NETWORK=testnet

# M6: keep submission disabled until separate transaction authorization.
M6_TRANSACTIONS_ENABLED=false
# A complete approved manifest may be used for read-only verification while false.
# Manifest presence never enables submission.
# M6_VAULT_ACCOUNT=avroqen-vault.testnet
# M6_WASM_SHA256=d2ec5048af0577b60c0aef4ecfd1aad1def4289828c841b2d7a7f83dd0f8428d
# M6_KEY_FINGERPRINTS=<comma-separated SHA-256 public-key/permission fingerprints>
# M6_AUTHORIZATION_REFERENCE=<reviewed November 11 replacement evidence / owner authorization reference>
