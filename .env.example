# Local development only. Copy to .env and replace the password placeholder.
# Never put wallet, owner, verifier, agent, or mainnet credentials here.
PGUSER=avroqen_dev
PGDATABASE=avroqen_dev
PGPASSWORD=REPLACE_WITH_LOCAL_ONLY_PASSWORD
PGHOST=127.0.0.1
PGPORT=55432
HOST=127.0.0.1
PORT=3001

# Explicit loopback-only HTTP authentication exception for local development.
PUBLIC_ORIGIN=http://127.0.0.1:3000
AUTH_ALLOW_INSECURE_LOCALHOST=true
NEAR_NETWORK=testnet
