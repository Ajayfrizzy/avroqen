{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/.next",
      "!**/next-env.d.ts",
      "!**/target",
      "!pnpm-lock.yaml",
      "!**/test-results",
      "!**/playwright-report",
      "!**/*.md",
      "!!.agents",
      "!!.git"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
